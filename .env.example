# ==========================================================
# Edu Pearl Immigration Services & Language Point
# Environment Configuration Template
# ==========================================================
# COPY THIS FILE TO .env AND FILL IN YOUR LOCAL VALUES:
#   copy .env.example .env
#
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL!
# ==========================================================

# Application Port
PORT=5000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=edupearl_user
DB_PASSWORD=your_secure_password_here
DB_NAME=edupearl_db

# Connection Pool Settings
DB_CONNECTION_LIMIT=10

# JWT Authentication Secrets
# REQUIRED: Must be a cryptographically random secret of at least 32 characters.
# Generate in Node.js terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=2h

